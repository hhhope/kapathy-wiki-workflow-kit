{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "settings": {
      "type": "object",
      "properties": {
        "oversized_hunk_line_threshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "rules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["match", "create_checks"],
        "properties": {
          "title": {
            "type": "string"
          },
          "match": {
            "type": "object",
            "required": ["any"],
            "properties": {
              "any": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "additionalProperties": true
          },
          "create_checks": {
            "type": "object",
            "required": ["required"],
            "properties": {
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "conditional": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
