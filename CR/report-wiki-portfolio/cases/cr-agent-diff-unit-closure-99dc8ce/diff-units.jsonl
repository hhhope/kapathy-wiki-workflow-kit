[\"status\"] = _closed_unit_status(statuses)", "+        else:", "+            unit[\"status\"] = \"open\"", "+    _refresh_coverage_counters(updated)", "+", "+"], "new_start": 68, "old_start": 67, "status": "satisfied", "unit_type": "hunk"}
